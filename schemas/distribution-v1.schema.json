{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OMDSH component-set definition",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "version",
    "channel",
    "name",
    "summary",
    "maintainers",
    "components"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "version": { "$ref": "#/$defs/version" },
    "channel": { "enum": ["preview", "stable"] },
    "name": { "$ref": "#/$defs/localizedName" },
    "summary": { "$ref": "#/$defs/localizedSummary" },
    "maintainers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/maintainer" }
    },
    "homepage": { "type": "string", "format": "uri", "pattern": "^https://" },
    "repository": { "type": "string", "format": "uri", "pattern": "^https://" },
    "intents": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
    },
    "localizedName": {
      "type": "object",
      "required": ["en", "zh-CN"],
      "properties": {
        "en": { "$ref": "#/$defs/nameText" },
        "zh-CN": { "$ref": "#/$defs/nameText" }
      },
      "propertyNames": { "$ref": "#/$defs/localeTag" },
      "additionalProperties": { "$ref": "#/$defs/nameText" }
    },
    "localizedSummary": {
      "type": "object",
      "required": ["en", "zh-CN"],
      "properties": {
        "en": { "$ref": "#/$defs/summaryText" },
        "zh-CN": { "$ref": "#/$defs/summaryText" }
      },
      "propertyNames": { "$ref": "#/$defs/localeTag" },
      "additionalProperties": { "$ref": "#/$defs/summaryText" }
    },
    "nameText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "\\S"
    },
    "summaryText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280,
      "pattern": "\\S"
    },
    "localeTag": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?(?:-(?:[A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*$"
    },
    "maintainer": {
      "type": "object",
      "required": ["name", "url"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "component": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$" },
        "version": { "$ref": "#/$defs/version" }
      }
    }
  }
}
